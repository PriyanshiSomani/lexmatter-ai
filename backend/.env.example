# LexMatter AI Environment Configuration

# Application
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
PROJECT_NAME="LexMatter AI"

# Database (PostgreSQL + pgvector)
# Async driver (used by FastAPI / SQLAlchemy async engine)
DATABASE_URL=postgresql+asyncpg://lexmatter_user:lexmatter_dev_password@localhost:5432/lexmatter_db

# Sync driver (used by Alembic migrations)
SYNC_DATABASE_URL=postgresql://lexmatter_user:lexmatter_dev_password@localhost:5432/lexmatter_db

# File Storage
UPLOAD_STORAGE_PATH=./storage/uploads
PREVIEW_STORAGE_PATH=./storage/previews

# LLM & Embedding Settings (configured in upcoming phases)
EMBEDDING_MODEL=all-mpnet-base-v2
EMBEDDING_DIMENSION=768
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
